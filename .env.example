# --- Application ---------------------------------------------------------
# Public origin of this deployment (metadataBase, widget embed URLs, emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Hosted mode only: public site that publishes the hosted service's legal
# policies (linked from signup and Product settings). Default https://supportseal.app.
# NEXT_PUBLIC_MARKETING_URL=https://marketing.example.com
# Central brand name shown in the UI (keep it configurable).
NEXT_PUBLIC_APP_NAME=SupportSeal

# --- Database ------------------------------------------------------------
# Postgres connection string. Leave empty in development to use a local
# file-backed PGlite database at .dev-data/pglite.db (migrate it with
# `npm run db:dev`). Production requires a real Postgres URL, e.g.
# DATABASE_URL=postgresql://user:password@localhost:5432/supportseal
DATABASE_URL=
# Hosted tier only: the hosted deployment sources its value from a secret
# manager (referenced by name in deployment config only; never commit the
# value) and uses a direct, non-pooled Postgres endpoint as DATABASE_URL.
# Self-hosting keeps the bundled compose Postgres.

# Attachment storage directory (default .dev-data/uploads; mount a volume in
# production — see docs/self-hosting.md).
# STORAGE_DIR=.dev-data/uploads

# --- Auth ----------------------------------------------------------------
# Session signing secret (required in production): openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional "Sign in with GitHub": set both to enable the button. Create a
# GitHub OAuth App with the callback URL
# ${NEXT_PUBLIC_APP_URL}/api/auth/callback/github (see docs/self-hosting.md).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Hosting mode ---------------------------------------------------------
# Leave unset/empty for self-hosted (single Workspace, no billing).
# Set to 1 only for the managed multi-tenant SaaS deployment.
# HOSTED_MODE=

# --- Widget rate limiting --------------------------------------------------
# Optional name of a trusted proxy header that carries the real client IP
# (e.g. cf-connecting-ip when the origin is only reachable through
# Cloudflare). Unset (default) keys on the LAST x-forwarded-for entry (the
# address your reverse proxy saw; forged entries to its left are ignored) and
# skips per-IP limits when no proxy header exists. Only set this when the
# app accepts traffic from that proxy alone (firewall or authenticated
# origin pulls / Tunnel) — otherwise the header is as spoofable as
# X-Forwarded-For. See docs/self-hosting.md.
# TRUSTED_PROXY_HEADER=

# --- Email -----------------------------------------------------------------
# Inbound webhook shared secret (also accepted as ?secret= on the URL for
# providers that cannot set headers). Use a URL-safe value (openssl rand
# -hex 32) because the SendGrid Inbound Parse URL embeds it (?secret=).
INBOUND_WEBHOOK_SECRET=
# Domain that receives forwarded support mail (product_xxx@INBOUND_EMAIL_DOMAIN).
INBOUND_EMAIL_DOMAIN=inbound.localhost
# Custom inbound mail domains (Product settings → Email): the MX host(s) customers
# must point their domain at, comma-separated. Unset = use the live MX records of
# INBOUND_EMAIL_DOMAIN (hosted: the apex). DNS verification runs from this server;
# MAIL_DNS_SERVERS (comma-separated host[:port]) overrides the resolvers it queries.
# INBOUND_MX_HOSTS=
# MAIL_DNS_SERVERS=
# Outbound: SendGrid API (hosted provider) takes precedence over SMTP. Use a
# dedicated key with the "Mail Send" scope only — never commit it.
# SENDGRID_API_KEY=
# Outbound SMTP URL (smtps://user:password@smtp.example.com:465). Without SendGrid or
# SMTP configured, agent replies are recorded but not delivered (dev mode).
SMTP_URL=
# Local part of the managed sender ("{Product} Support" <OUTBOUND_EMAIL_LOCAL@INBOUND_EMAIL_DOMAIN>).
OUTBOUND_EMAIL_LOCAL=no-reply

# Optional: lets a scheduler call POST /api/internal/escalations/sweep
# (Authorization: Bearer <secret>) for tight unanswered-request alert latency.
# CRON_SECRET=

# --- Hosted billing (hosted mode only; self-hosting never needs these) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# One recurring USD price per plan x interval (Stripe price ids). Prices
# carry lookup keys supportseal_{pro,business}_{monthly,annual}, which map a
# subscription back to its plan.
# STRIPE_PRO_MONTHLY_PRICE_ID=
# STRIPE_PRO_ANNUAL_PRICE_ID=
# STRIPE_BUSINESS_MONTHLY_PRICE_ID=
# STRIPE_BUSINESS_ANNUAL_PRICE_ID=
# All Stripe values must come from the SAME mode (all test or all live):
# billing refuses with billing_misconfigured when the key, prices and webhook
# secret disagree (issue #25).
# Free plan included conversations per month (default 100). The Free grace
# period is fixed at 7 days; USAGE_GRACE_DAYS lengthens paid plans' soft
# grace window (minimum and default 30):
# FREE_TIER_CONVERSATION_LIMIT=100
# USAGE_GRACE_DAYS=30

# --- Local development ---------------------------------------------------
# Optional comma-separated origins for accessing the dev server from other devices.
# DEV_ALLOWED_ORIGINS=dev.example.test
